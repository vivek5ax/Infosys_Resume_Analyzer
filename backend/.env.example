# Groq AI enrichment controls for the current feature deployment
GROQ_MATCH_API_KEY=your_groq_match_api_key_here
GROQ_MATCH_ENABLED=true
GROQ_MATCH_MODEL=llama-3.1-8b-instant
GROQ_MATCH_API_URL=https://api.groq.com/openai/v1/chat/completions

# General Groq enrichment (optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SEC=18
GROQ_MAX_RETRIES=2

# AI enrichment control
AI_ENRICHMENT_ENABLED=true
AI_ENRICHMENT_MODE=shadow

# Database and auth (not required for the current feature-only deployment)
# MONGODB_URI=your_mongodb_connection_string
# DATABASE_NAME=resume_analyzer
# JWT_SECRET_KEY=replace_with_a_secure_random_secret
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# BCRYPT_ROUNDS=12

# App behavior
CHATBOT_ENABLED=true

# Enhanced Semantic Matcher Configuration
USE_ENHANCED_MATCHER=true
USE_LLM_SEMANTIC=true

# Frontend URL(s) allowed by CORS.
# For local development/testing set this to your dev host (default):
# FRONTEND_ORIGIN=http://localhost:5173
#
# For Render/production set this to your deployed frontend URL, e.g.:
# FRONTEND_ORIGIN=https://infosys-resume-analyzer.vercel.app/
#
# Default below is set for local testing. Change when deploying to Render.
FRONTEND_ORIGIN=http://localhost:5173
